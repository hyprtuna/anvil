# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
dist-experimental/
build/
*.tsbuildinfo

# Reference material (research only — not part of the project)
/references/

# Generated platform manifests (output of `anvil` install)
.claude/
.opencode/

# Anvil's own dogfooding workspace. The tool writes plans, tickets, audits,
# research, and per-project runtime state into .anvil/ — none of that belongs
# in this repo. Only the architectural spec docs under .anvil/specs/ are tracked.
.anvil/*
!.anvil/specs/
!.anvil/specs/**

# Environment & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/

# Temporary
.cache/
tmp/
temp/

# Forge legacy output (pre-Anvil)
forge-output/

# Git worktrees (isolated development workspaces)
.worktrees/

# Compiled hooks (output of `npm run build`)
dist-hooks/

# References
references/
